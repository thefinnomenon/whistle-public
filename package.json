{
  "name": "whistle",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:devclient": "expo start --dev-client",
    "eas:build:dev": "eas build --profile development --platform all",
    "eas:build:emulator:dev:ios": "eas build --profile development-simulator --platform ios",
    "eas:build:emulator:dev:ios:local": "eas build --profile development-simulator --platform ios --local",
    "eas:build:dev:ios": "eas build --profile development --platform ios",
    "eas:build:dev:android": "eas build --profile development --platform android",
    "fb:deploy:functions": "cd functions && npm run deploy:functions",
    "fb:deploy:rules": "cd functions && npm run deploy:rules",
    "fb:emulator": "cd functions && npm run serve",
    "fb:emulator:kill": "cd functions && npm run reset",
    "start:dev": "cp .env.development .env && expo start",
    "start:prod": "cp .env.production .env && expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:dev": "cp .env.development .env && expo start --android",
    "android:prod": "cp .env.production .env && expo start --android",
    "ios": "expo run:ios",
    "ios:dev": "cp .env.development .env && expo start --ios",
    "ios:prod": "cp .env.production .env && expo start --ios",
    "web": "expo start --web",
    "web:dev": "cp .env.development .env && expo start --web",
    "web:staging": "cp .env.staging .env && expo start --web",
    "web:prod": "cp .env.production .env && expo start --web",
    "build:dev": "eas build --profile development",
    "build:dev:local": "eas build --profile development --local",
    "build:dev:local:ios": "eas build --profile development --platform ios --local",
    "build:dev:local:android": "eas build --profile development --platform android --local",
    "build:prod": "cp .env.production .env && eas build --profile production",
    "build:prod:local": "cp .env.production .env && eas build --profile production --local",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "email:previews": "email dev --port 3001",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@google-cloud/firestore": "^7.11.6",
    "@hookform/resolvers": "^5.2.2",
    "@react-email/components": "^0.5.6",
    "@react-email/tailwind": "^1.2.2",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-firebase/app": "^23.4.0",
    "@react-native-firebase/auth": "^23.4.0",
    "@react-native-firebase/firestore": "^23.4.0",
    "@react-native-firebase/messaging": "^23.4.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@rn-primitives/accordion": "^1.2.0",
    "@rn-primitives/alert-dialog": "^1.2.0",
    "@rn-primitives/avatar": "^1.2.0",
    "@rn-primitives/checkbox": "^1.2.0",
    "@rn-primitives/context-menu": "^1.2.0",
    "@rn-primitives/dialog": "^1.2.0",
    "@rn-primitives/dropdown-menu": "^1.2.0",
    "@rn-primitives/label": "^1.2.0",
    "@rn-primitives/portal": "^1.3.0",
    "@rn-primitives/progress": "^1.2.0",
    "@rn-primitives/radio-group": "^1.2.0",
    "@rn-primitives/select": "^1.2.0",
    "@rn-primitives/separator": "^1.2.0",
    "@rn-primitives/slot": "^1.2.0",
    "@rn-primitives/switch": "^1.2.0",
    "@rn-primitives/tabs": "^1.2.0",
    "@rn-primitives/toggle": "^1.2.0",
    "@rn-primitives/toggle-group": "^1.2.0",
    "@rn-primitives/tooltip": "^1.2.0",
    "@sentry/react-native": "~7.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "expo": "~54.0.10",
    "expo-build-properties": "~1.0.9",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.14",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.8",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.7",
    "lucide-react-native": "^0.545.0",
    "mixpanel": "^0.18.1",
    "mixpanel-react-native": "^3.1.2",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-email": "^4.3.0",
    "react-hook-form": "^7.64.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.6.0",
    "resend": "^6.1.2",
    "sonner-native": "^0.21.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@react-email/preview-server": "4.3.0",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.17",
    "tsc-files": "^1.1.4",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": "bash -c 'tsc --noEmit'"
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "resolutions": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
