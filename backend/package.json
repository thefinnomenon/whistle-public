{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"yarn tunnel > /dev/null\" \"env-cmd -f .env.development -- ts-node-dev --respawn --transpile-only src/index.ts\"",
    "dev:prod": "env-cmd -f .env.production -- ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "env-cmd -f .env.production node dist/index.js",
    "tunnel": "ssh -p 443 -R0:localhost:4000 -o StrictHostKeyChecking=no -o ServerAliveInterval=30 configure@example.com",
    "run:dev": "env-cmd -f .env.development -- ts-node",
    "run:prod": "env-cmd -f .env.production -- ts-node",
    "sim-game": "ts-node scripts/parseTestGames.ts testGames/playbyplay_0022400247.json",
    "sim": "env-cmd -f .env.development -- ts-node scripts/simGameFromDb.ts",
    "sim:nfl": "env-cmd -f .env.development -- ts-node scripts/simNflQuestions.ts",
    "test:featured-game": "ts-node scripts/testFeaturedGame.ts",
    "test:game-payout": "ts-node scripts/testGamePayout.ts",
    "test:game-payout-integration": "ts-node scripts/testPayoutIntegration.ts",
    "test:nfl-questions": "ts-node scripts/testNflQuestions.ts",
    "test:event-replay-storage": "ts-node scripts/testEventReplayStorage.ts"
  },
  "dependencies": {
    "@sentry/node": "^7.120.3",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "firebase-admin": "^13.6.0",
    "mixpanel": "^0.19.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.1",
    "concurrently": "^9.2.1",
    "env-cmd": "^11.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
