rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  	// Default deny all
  	match /{document=**} {
      allow read, write: if false;
    }
    
  	// Users can read their own user document
  	match /users/{userId} {
      allow read: if isSignedIn() && isUser(userId);
      // Users can create their own user document with their UID and auth email
      allow create: if isSignedIn()
        && isUser(userId)
        && request.resource.data.id == request.auth.uid
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
      // Users can only update tokens and updatedAt fields
      allow update: if isSignedIn() && isUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens', 'updatedAt']);
      // Users can delete their own account
      allow delete: if isSignedIn() && isUser(userId);
    }

  	// CRUD for user's subcollections
  	match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isUser(userId);
    }

    // Users can read/write their own predictions for games they're in
    match /users/{userId}/games/{gameId}/predictions/{questionId} {
      allow read: if isSignedIn() && isUser(userId);
      allow write: if isSignedIn() && isUser(userId) && userIsInGame(gameId);
    }

    // User can create a username entry with user = uid
    match /usernames/{username} {
    	allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.user == request.auth.uid;
      // Users can delete their own username when deleting account
      allow delete: if isSignedIn() && resource.data.user == request.auth.uid;
    }
    
    // Admins can CRUD games
    match /games/{game=**} {
    	allow read, write: if isAdmin();
    }
    
    // All users can read game info
    	// Users in game can read questions
    		// Users can read their predictions
    		// Users can create their prediction with userId as docId if question is open
      // Users can read, delete, and create their user record (score = 0)
    match /games/{gameId} {
      allow read: if isSignedIn();
        match /questions/{questionId} {
          allow read: if isSignedIn() && userIsInGame(gameId);
          match /predictions/{userId} {
            allow read: if isSignedIn() && isUser(userId) && userIsInGame(gameId);
            allow create: if isSignedIn()
              && isUser(userId)
              && userIsInGame(gameId)
              && isQuestionOpen(gameId, questionId)
              && request.resource.data.keys().hasOnly(['prediction'])
              && request.resource.data.prediction is bool;
          }
        }
        match /users/{userId} {
          allow read, delete: if isSignedIn() && isUser(userId);
          allow create: if isSignedIn() && isUser(userId) && request.resource.data.score == 0 && isUsername();
        }
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return uid == request.auth.uid;
    }

    function isAdmin() {
    	return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isUsername() {
    	return get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.user == request.auth.uid; 
    }
    
    function isGameScheduled() {
    	return resource.data.state == 'scheduled';
    }
    
    function userIsInGame(gameId) {
    	return exists(/databases/$(database)/documents/games/$(gameId)/users/$(request.auth.uid))
    }
    
    function isQuestionOpen(gameId, questionId) {
    	return get(/databases/$(database)/documents/games/$(gameId)/questions/$(questionId)).data.state == 'open';
    }
  }
}