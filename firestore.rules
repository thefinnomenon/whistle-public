rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  	// Default deny all
  	match /{document=**} {
      allow read, write: if false;
    }
    
  	// Users can read their own user document
  	match /users/{userId} {
      allow read: if isSignedIn() && isUser(userId);
      // Users can create their own user document with their UID and auth email
      allow create: if isSignedIn()
        && isUser(userId)
        && request.resource.data.id == request.auth.uid
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
      // Users can only update tokens and updatedAt fields
      allow update: if isSignedIn() && isUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens', 'updatedAt']);
      // Account deletion goes through the API so game membership and counts are
      // cleaned up atomically before the auth user is removed.
    }

    match /users/{userId}/games/{gameId} {
      allow read: if isSignedIn() && isUser(userId);
    }

    // Practice data is local to the signed-in user and has no prize impact.
    match /users/{userId}/practice/{document=**} {
      allow read, write: if isSignedIn() && isUser(userId);
    }

    // User can create a username entry with user = uid
    match /usernames/{username} {
    	allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.user == request.auth.uid;
    }
    
    // Admins can CRUD games
    match /games/{game=**} {
    	allow read, write: if isAdmin();
    }
    
    // Membership and prediction writes go through the authenticated API so
    // player counts, eligibility, and cash payouts cannot be bypassed.
    match /games/{gameId} {
      allow read: if isSignedIn();
        match /questions/{questionId} {
          allow read: if isSignedIn() && userIsInGame(gameId);
          match /predictions/{userId} {
            allow read: if isSignedIn() && isUser(userId) && userIsInGame(gameId);
          }
        }
        match /users/{userId} {
          allow read: if isSignedIn() && isUser(userId);
        }
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return uid == request.auth.uid;
    }

    function isAdmin() {
    	return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function userIsInGame(gameId) {
    	return exists(/databases/$(database)/documents/games/$(gameId)/users/$(request.auth.uid))
    }
  }
}
